datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  CUSTOMER
  MASTER
  ADMIN
}

enum MasterStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum RequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  firstName  String
  lastName   String?
  username   String?
  photoUrl   String?
  phone      String?
  role       UserRole @default(CUSTOMER)
  isBlocked  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  masterProfile  MasterProfile?
  requests       Request[]       @relation("CustomerRequests")
  reviewsWritten Review[]        @relation("CustomerReviews")
  auditLogs      AuditLog[]      @relation("UserAuditLogs")
  notificationLogs NotificationLog[]

  @@map("users")
}

model Service {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameUz   String
  isActive Boolean @default(true)

  masters  MasterProfile[] @relation("MasterServices")
  requests Request[]

  @@map("services")
}

model District {
  id     String @id @default(cuid())
  nameUz String @unique

  masters  MasterProfile[] @relation("MasterDistricts")
  requests Request[]

  @@map("districts")
}

model MasterProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio             String
  experienceYears Int
  status          MasterStatus @default(PENDING)
  rejectReason    String?
  ratingAvg       Decimal      @default(0) @db.Decimal(3, 2)
  ratingCount     Int          @default(0)
  completedCount  Int          @default(0)
  createdAt       DateTime     @default(now())

  services        Service[]    @relation("MasterServices")
  districts       District[]   @relation("MasterDistricts")
  offers          Offer[]
  reviewsReceived Review[]

  @@map("master_profiles")
}

model Request {
  id              String        @id @default(cuid())
  customerId      String
  customer        User          @relation("CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  serviceId       String
  service         Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  districtId      String
  district        District      @relation(fields: [districtId], references: [id], onDelete: Restrict)
  title           String
  description     String
  addressDetail   String
  preferredTime   String?
  budgetMin       Int?
  budgetMax       Int?
  status          RequestStatus @default(OPEN)
  selectedOfferId String?       @unique
  selectedOffer   Offer?        @relation("SelectedOffer", fields: [selectedOfferId], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  photos          RequestPhoto[]
  offers          Offer[]        @relation("RequestOffers")
  review          Review?
  notificationLogs NotificationLog[]

  @@index([status, serviceId, districtId])
  @@map("requests")
}

model RequestPhoto {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  storagePath String
  createdAt   DateTime @default(now())

  @@map("request_photos")
}

model Offer {
  id        String      @id @default(cuid())
  requestId String
  request   Request     @relation("RequestOffers", fields: [requestId], references: [id], onDelete: Cascade)
  masterId  String
  master    MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  price     Int
  message   String
  status    OfferStatus @default(PENDING)
  createdAt DateTime    @default(now())

  selectedInRequest Request? @relation("SelectedOffer")

  @@unique([requestId, masterId])
  @@index([requestId])
  @@index([masterId])
  @@map("offers")
}

model Review {
  id         String        @id @default(cuid())
  requestId  String        @unique
  request    Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  customerId String
  customer   User          @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  masterId   String
  master     MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  rating     Int
  comment    String?
  createdAt  DateTime      @default(now())

  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String
  meta      Json?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

enum NotificationStatus {
  SENT
  FAILED
}

model NotificationLog {
  id        String             @id @default(cuid())
  requestId String
  request   Request            @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String             @default("NEW_REQUEST")
  status    NotificationStatus
  error     String?
  createdAt DateTime           @default(now())

  @@unique([requestId, userId])
  @@index([userId])
  @@index([requestId])
  @@map("notification_logs")
}

